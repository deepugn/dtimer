datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        @default("USER") // USER, ADMIN
  tier         String        @default("PRO")  // FREE, PRO, ENTERPRISE
  timezone     String        @default("UTC")
  weekStart    String        @default("MONDAY")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tags         Tag[]
  tasks        Task[]
  stopwatches  Stopwatch[]
  timeSessions TimeSession[]

  @@map("users")
}

model Tag {
  id           String        @id @default(cuid())
  userId       String
  name         String
  color        String        @default("#3B82F6")
  icon         String        @default("🏷️")
  createdAt    DateTime      @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stopwatches  Stopwatch[]   @relation("StopwatchTags")
  tasks        Task[]        @relation("TaskTags")
  timeSessions TimeSession[] @relation("SessionTags")

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model Task {
  id               String        @id @default(cuid())
  userId           String
  title            String
  description      String?
  estimatedMinutes Int?          @default(0)
  status           String        @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, ARCHIVED
  priority         String        @default("MEDIUM")  // LOW, MEDIUM, HIGH
  dueDate          DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags             Tag[]         @relation("TaskTags")
  stopwatches      Stopwatch[]
  timeSessions     TimeSession[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("tasks")
}

model Stopwatch {
  id            String        @id @default(cuid())
  userId        String
  taskId        String?
  name          String
  status        String        @default("PAUSED") // RUNNING, PAUSED, STOPPED
  accumulatedMs Int           @default(0)
  lastStartedAt DateTime?
  color         String        @default("#3B82F6")
  isFocusMode   Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  tags          Tag[]         @relation("StopwatchTags")
  laps          Lap[]
  timeSessions  TimeSession[]

  @@index([userId])
  @@map("stopwatches")
}

model Lap {
  id          String    @id @default(cuid())
  stopwatchId String
  lapNumber   Int
  splitTimeMs Int
  lapTimeMs   Int
  note        String?
  createdAt   DateTime  @default(now())

  stopwatch   Stopwatch @relation(fields: [stopwatchId], references: [id], onDelete: Cascade)

  @@index([stopwatchId])
  @@map("laps")
}

model TimeSession {
  id          String    @id @default(cuid())
  userId      String
  stopwatchId String?
  taskId      String?
  title       String
  startTime   DateTime
  endTime     DateTime
  durationMs  Int
  notes       String?
  createdAt   DateTime  @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stopwatch   Stopwatch? @relation(fields: [stopwatchId], references: [id], onDelete: SetNull)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  tags        Tag[]      @relation("SessionTags")

  @@index([userId, startTime])
  @@index([userId, taskId])
  @@index([userId, stopwatchId])
  @@map("time_sessions")
}
